#!/bin/sh
# locklog: the launcher. locklog runs in Docker; this script, installed as
# `locklog` on the host by scripts/install.sh, runs every command in the
# image, each with the account, the mounts and the network it needs. The
# console is not one of them: it is started by `lox run` only (lockhub),
# hub-attached, with the log directories of the profile's mount plan; the
# launcher refuses `console`.
#
#   profile add
#              as you, in the image: a profile of the trusted .locklog/
#              config.toml from this host's facts (log files, journal,
#              containers), a Compose Loki's proxy (its files in
#              ~/.config/locklog/proxy, outside the project); the project is
#              this one, or the one --project DIR names
#   profile rules
#              as the agent account, the project read-only, no network: the
#              auto rules of the project's profiles (read by lox run)
#   init       as you, in the image, with the project writable: the agent's
#              project wiring
#   doctor     as the agent account, with the host's network: what an
#              agent here can reach (advisory), and the agents' wiring; with
#              the socket volume of the workspace's locklog lock that `lox
#              run` runs, read-only, when there is one (else it says why).
#              doctor --fix runs as you, with the project writable: it
#              wires the agents not wired yet
#   mcp        as the image's agent account (uid 10052): the MCP server of
#              a host agent (the non-production trial; the server refuses
#              production profiles), with the socket volume of the
#              workspace's locklog lock that `lox run` runs (read from
#              .lockfamily/up.json and checked with Docker; --instance NAME
#              picks one of several), read-only, and the project
#              (read-only); none without `lox run`
#   update     replace this launcher with a release's, then pull its image
#   version    this launcher's and the image's versions
#   anything else  as the agent account, with the project (read-only) and
#              no volume: mounts, help...
#
# The project (the nearest directory up from here that holds .locklog/, or
# this directory) is mounted read-only at its own path.
#
# Environment:
#   LOCKLOG_IMAGE        image to run (default: the release image of this
#                        launcher's version; `locklog` for a launcher run
#                        from a clone, the tag of `docker build -t locklog .`)
#   LOCKLOG_VAULT=1      the image with the vault CLI (credentials = "vault")
#   LOCKLOG_EXTRA_ROOTS  log directories beyond the built-in allowlist
#                        (/var/log, /run/log/journal), separated by spaces:
#                        profile add detects the log files under them too
#   XDG_STATE_HOME       where `lox run` keeps its state (its compose
#                        project), checked against the containers that mount
#                        the socket volume
set -eu

# scripts/install.sh and locklog update write the release version here,
# and the digests of its images once their cosign signatures verify: the
# launcher then runs the image by digest, never by a tag that could move.
launcher_version=dev
image_digest=
vault_image_digest=

repo="DavidGodefroid/locklog"
registry="ghcr.io/davidgodefroid/locklog"

say() { printf 'locklog: %s\n' "$*" >&2; }
die() {
	say "$*"
	exit 1
}

image="${LOCKLOG_IMAGE:-}"
if [ -z "$image" ]; then
	if [ "$launcher_version" = dev ]; then
		image=locklog
	else
		image="$registry:$launcher_version"
	fi
	if [ "$launcher_version" != dev ] && [ -n "$image_digest" ]; then
		image="$registry@$image_digest"
		[ "${LOCKLOG_VAULT:-0}" = 1 ] && image="$registry@$vault_image_digest"
	elif [ "${LOCKLOG_VAULT:-0}" = 1 ]; then
		case "$image" in
		*:*) image="$image-vault" ;;
		*) image="$image:vault" ;;
		esac
	fi
fi

tty=-i
if [ -t 0 ] && [ -t 1 ]; then tty=-it; fi

need_docker() {
	command -v docker >/dev/null 2>&1 || die "docker is required: locklog runs in Docker"
}

# safe PATH: PATH holds none of the characters a docker -v or --mount spec,
# the LOCKLOG_EXPECT_ROOTS list (entries "dev:inode path;") or the mount
# plan cannot carry.
safe() {
	case "$1" in
	*[,=:\;\"\'\`\\]* | *"
"*) return 1 ;;
	esac
	printf '%s' "$1" | LC_ALL=C grep -q '[[:cntrl:]]' && return 1
	return 0
}

# physical DIR: DIR is an existing directory whose physical path is itself
# (no symbolic link on its path, no "..").
physical() {
	[ -d "$1" ] && [ ! -L "$1" ] && [ "$(cd "$1" 2>/dev/null && pwd -P)" = "$1" ]
}

# Portable stat: the octal mode of PATH.
if [ "$(uname -s)" = Darwin ]; then
	fmode() { stat -f '%Mp%Lp' "$1"; }
else
	fmode() { stat -c '%a' "$1"; }
fi

# fowner PATH: the numeric owner of PATH.
if [ "$(uname -s)" = Darwin ]; then
	fowner() { stat -f '%u' "$1"; }
else
	fowner() { stat -c '%u' "$1"; }
fi

# perm PATH: sets special (setuid/setgid/sticky digit), g and o (the
# group's and the others' digits) from the octal mode of PATH.
perm() {
	m=000$(fmode "$1")
	l=${m#"${m%???}"}
	sp=${m%???}
	special=${sp#"${sp%?}"}
	g=$(printf '%s' "$l" | cut -c2)
	o=$(printf '%s' "$l" | cut -c3)
}

# has_acl PATH: PATH carries an access control list ("+" after the mode
# in ls -ld): its mode bits do not say who can write it.
has_acl() {
	if [ "$(uname -s)" = Darwin ]; then
		# macOS prints "@" over "+" when there are xattrs too: ls -le lists
		# the ACL entries themselves, after the first line.
		[ -n "$(ls -lde "$1" 2>/dev/null | sed -n 2p)" ]
		return
	fi
	case "$(ls -ld "$1" 2>/dev/null | cut -c11)" in
	+) return 0 ;;
	esac
	return 1
}

# mine PATH: PATH is owned by you or by root.
mine() {
	ow=$(fowner "$1")
	[ "$ow" = "$(id -u)" ] || [ "$ow" = 0 ]
}

# trusted PATH: PATH is not a symbolic link, is owned by you or root, has
# no ACL, and no one else can write it.
trusted() {
	[ -e "$1" ] && [ ! -L "$1" ] || return 1
	mine "$1" || return 1
	has_acl "$1" && return 1
	perm "$1"
	[ $((g & 2)) -eq 0 ] && [ $((o & 2)) -eq 0 ]
}

# shared DIR: DIR is writable by others than its owner, sticky (/tmp),
# owned by someone else than you or root, or under an ACL: someone else
# could have created, or could replace, a .locklog/ in it.
shared() {
	mine "$1" || return 0
	has_acl "$1" && return 0
	perm "$1"
	[ $((special & 1)) -ne 0 ] || [ $((g & 2)) -ne 0 ] || [ $((o & 2)) -ne 0 ]
}

# trusted_config DIR: DIR/.locklog is a trusted directory, and its
# config.toml (when present) a trusted file.
trusted_config() {
	[ -d "$1/.locklog" ] && trusted "$1/.locklog" || return 1
	[ ! -e "$1/.locklog/config.toml" ] && [ ! -L "$1/.locklog/config.toml" ] && return 0
	[ -f "$1/.locklog/config.toml" ] && trusted "$1/.locklog/config.toml"
}

# The project root: the nearest directory up from here that holds a
# .locklog/ you own (or root does) and no one else can write, with its
# config.toml likewise. The walk never goes above your home directory (when
# here is in it), never past a directory others can write or a sticky one
# (/tmp), and never takes / itself: a .locklog/ someone else planted there
# would choose the logs the console serves. Without one, the commands run
# with this directory as the project (mounted read-only).
here="$(pwd -P)"
project="$here"
home_dir=
if [ -n "${HOME:-}" ]; then home_dir="$(cd "$HOME" 2>/dev/null && pwd -P)" || home_dir=; fi
d="$here"
while :; do
	[ "$d" = / ] && break
	# Your home directory is never a project: a ~/.locklog/ would choose
	# the logs of every directory below it.
	if [ -n "$home_dir" ] && [ "$d" = "$home_dir" ]; then
		if [ -e "$d/.locklog" ] || [ -L "$d/.locklog" ]; then
			say "warning: ignoring $d/.locklog: your home directory is not a project (run locklog profile add in a project directory)"
		fi
		break
	fi
	if [ -e "$d/.locklog" ] || [ -L "$d/.locklog" ]; then
		if ! shared "$d" && trusted_config "$d"; then
			project="$d"
		else
			say "warning: ignoring $d/.locklog: it, its config.toml or $d is a link, has an ACL, or is owned or writable by someone else than you"
		fi
		break
	fi
	shared "$d" && break
	d="$(dirname "$d")"
done
case "$here" in
"$project" | "$project"/*) workdir=$here ;;
*) workdir=$project ;;
esac

# The log roots profile add detects log files under.
roots="/var/log /run/log/journal"
# Split on spaces, never globbed.
set -f
for r in ${LOCKLOG_EXTRA_ROOTS:-}; do
	case "$r" in
	/) die "LOCKLOG_EXTRA_ROOTS: / cannot be a log root" ;;
	/*) ;;
	*) die "LOCKLOG_EXTRA_ROOTS: $r is not an absolute path" ;;
	esac
	case "$r" in *[*?[]*) die "LOCKLOG_EXTRA_ROOTS: $r holds a glob character" ;; esac
	safe "$r" || die "LOCKLOG_EXTRA_ROOTS: $r holds a character a mount cannot carry"
	physical "$r" || die "LOCKLOG_EXTRA_ROOTS: $r is not a directory with no symbolic link on its path"
	roots="$roots $r"
done
set +f

# Locks started by `lox run` (lockhub's docs/lox-run.md, "up.json (version
# 1)" and "Host agents: the locks' launchers"): `lox run` runs each lock's
# console under compose, with its socket in the volume
# lockfamily-<sha256 of the workspace, 8 hex>_<instance>-run, and names it
# in <workspace>/.lockfamily/up.json. The agent commands mount that volume
# read-only on /run/locklog (connecting needs no write), never a fixed one:
# the consoles run hub-attached only, started by `lox run`. The checks are
# those of lea, which mounts the same volumes for its agents: up.json is
# the user's own regular file (no link) that no one else can write, in a
# .lockfamily of the same kind, of this very workspace; then Docker must
# confirm the volume: lox run's labels (project, role socket, instance,
# type, workspace), and every container that mounts it is lox run's (run by
# compose from lox run's own state directory) or mounts it read-only.
# These checks catch mistakes and files others can write; an agent that
# runs as you with Docker access gets past any of them (lockhub's threat
# model). up.json only names the instance: what is mounted is what Docker's
# labels prove, read as JSON, compared whole; anything else fails closed.

# json_safe S: S holds nothing JSON escapes (a quote, a backslash, a
# control character, U+2028, U+2029): "S" is then its JSON encoding.
json_safe() {
	case "$1" in *'"'* | *'\'* | *"$(printf '\342\200\250')"* | *"$(printf '\342\200\251')"*) return 1 ;; esac
	[ "$(printf '%s' "$1" | LC_ALL=C tr -d '\001-\037')" = "$1" ]
}

# private PATH: PATH is no link, is the user's, and neither its group nor
# others may write it.
private() {
	[ ! -L "$1" ] && [ "$(ls -nd "$1" | awk '{ print $3 }')" = "$(id -u)" ] &&
		[ -z "$(find "$1" -prune \( -perm -0020 -o -perm -0002 \) -print)" ]
}

# sha8 S: the first 8 hex digits of the sha256 of S (lox run's project).
sha8() {
	if command -v sha256sum >/dev/null 2>&1; then
		printf '%s' "$1" | sha256sum
	else
		printf '%s' "$1" | shasum -a 256
	fi | awk '{ print substr($1, 1, 8) }'
}

# lockup_parse < up.json: lox run's state (version 1, written by Go's
# json.MarshalIndent with a two-space indent): a line Pproject, a line
# Wworkspace, then a line Lname socket_volume client_gid per lock of type
# locklog. Fails on anything else, or on a value it would have to unescape.
lockup_parse() {
	awk -v want=locklog '
	function str(v) {
		if (v !~ /^"[^"\\]*"$/ || v ~ /[\001-\037]/) { bad = 1; return "" }
		return substr(v, 2, length(v) - 2)
	}
	{ line = $0 }
	NR == 1 { if (line != "{") bad = 1; next }
	{ last = line; match(line, /^ */); ind = RLENGTH; rest = substr(line, ind + 1) }
	rest == "}" || rest == "}," {
		if (inlocks && ind == 4) cur = ""
		else if (inlocks && ind == 2) inlocks = 0
		next
	}
	rest !~ /^"[^"\\]*": / { next }
	{
		k = substr(rest, 2, index(rest, "\":") - 2)
		v = substr(rest, length(k) + 5)
		sub(/,$/, "", v)
	}
	!inlocks && ind == 2 {
		if (k == "version") version = v
		else if (k == "project") project = str(v)
		else if (k == "workspace") workspace = str(v)
		else if (k == "locks") { if (v == "{") inlocks = 1; else if (v != "{}") bad = 1; locks = 1 }
		next
	}
	inlocks && ind == 4 {
		if (v != "{" || (k in seen)) bad = 1
		seen[k] = 1; cur = k; n++; name[n] = k
		next
	}
	inlocks && ind == 6 && cur != "" {
		if (k == "type" || k == "socket_volume" || k == "client_gid") f[cur, k] = str(v)
	}
	END {
		if (bad || last != "}" || inlocks || !locks || version != "1") exit 1
		print "P" project
		print "W" workspace
		for (i = 1; i <= n; i++) {
			c = name[i]
			if (f[c, "type"] != want) continue
			if (c !~ /^[a-z0-9][a-z0-9-]*$/ || length(c) > 63 || f[c, "socket_volume"] !~ /^[a-z0-9][a-z0-9_.-]*$/ || f[c, "client_gid"] !~ /^[0-9]*$/) exit 1
			print "L" c " " f[c, "socket_volume"] " " f[c, "client_gid"]
		}
	}'
}

# lockup_volume [INSTANCE]: the socket volume of the locklog lock (INSTANCE,
# the only one without it) that `lox run` runs for the workspace of this
# directory, in $lockup_vol; when there is none the agents can trust, why,
# with what to do, in $lockup_why.
lockup_volume() {
	lockup_vol='' lockup_why=''
	lu_inst=${1:-}
	# The workspace: the nearest directory up from here whose .lockfamily
	# holds up.json (a sub-project's own .lockfamily may hold none).
	lu_ws=
	lu_d=$here
	while :; do
		if [ -e "$lu_d/.lockfamily/up.json" ] || [ -L "$lu_d/.lockfamily/up.json" ] || [ -L "$lu_d/.lockfamily" ]; then
			lu_ws=$lu_d
			break
		fi
		[ "$lu_d" = / ] && break
		lu_d=$(dirname "$lu_d")
	done
	if [ -z "$lu_ws" ]; then
		lockup_why="no .lockfamily/up.json in $here or above it: run \`lox run\` first (lockhub: lox add locklog <name>, then lox run in a terminal of its own), then run locklog from the workspace"
		return 1
	fi
	lu_lf=$lu_ws/.lockfamily
	lu_f=$lu_lf/up.json
	if [ -L "$lu_lf" ] || [ ! -d "$lu_lf" ]; then
		lockup_why="$lu_lf is not a directory (a link?): it is not lox run's; run \`lox run\` first"
		return 1
	fi
	if ! private "$lu_lf"; then
		lockup_why="$lu_lf is not yours, or others than you may write it: locklog trusts none of it (chmod go-w it, then run \`lox run\`)"
		return 1
	fi
	if [ -L "$lu_f" ] || [ ! -f "$lu_f" ]; then
		lockup_why="$lu_f is not a regular file (a link?): it is not lox run's; run \`lox run\` first"
		return 1
	fi
	if ! private "$lu_f"; then
		lockup_why="$lu_f is not yours, or others than you may write it: locklog trusts none of it; run \`lox run\` first"
		return 1
	fi
	if [ "$(wc -c <"$lu_f")" -gt 1048576 ]; then
		lockup_why="$lu_f is larger than 1 MiB: it is not lox run's; run \`lox run\` first"
		return 1
	fi
	lu_ino=$(ls -di "$lu_f")
	if ! lu_state=$(lockup_parse <"$lu_f") || [ -L "$lu_f" ] || [ "$(ls -di "$lu_f")" != "$lu_ino" ]; then
		lockup_why="$lu_f is not lox run's state (version 1): run \`lox run\` first"
		return 1
	fi
	lu_project='' lu_wsf='' lu_locks=''
	while IFS= read -r lu_line; do
		case "$lu_line" in
		P*) lu_project=${lu_line#P} ;;
		W*) lu_wsf=${lu_line#W} ;;
		L*) lu_locks="$lu_locks${lu_line#L}
" ;;
		esac
	done <<EOF_STATE
$lu_state
EOF_STATE
	lu_want="lockfamily-$(sha8 "$lu_ws")"
	if [ "$lu_project" != "$lu_want" ] || [ "$lu_wsf" != "$lu_ws" ]; then
		lockup_why="$lu_f: project $lu_project of $lu_wsf, not this workspace's ($lu_want of $lu_ws): run \`lox run\` in $lu_ws"
		return 1
	fi
	if ! json_safe "$lu_ws"; then
		lockup_why="the workspace's path $lu_ws holds a quote, a backslash or a control character: locklog cannot check lox run's labels; move or rename it"
		return 1
	fi
	lu_names=$(printf '%s' "$lu_locks" | awk '{ print $1 }' | sort | tr '\n' ' ')
	lu_names=${lu_names% }
	if [ -n "$lu_inst" ]; then
		case "$lu_inst" in
		*[!a-z0-9-]* | -*)
			lockup_why="--instance: not an instance name (lowercase letters, digits and -)"
			return 1
			;;
		esac
		lu_sel=$(printf '%s' "$lu_locks" | awk -v n="$lu_inst" '$1 == n')
		if [ -z "$lu_sel" ]; then
			lockup_why="lox run runs no locklog lock $lu_inst in $lu_ws (its locklog locks: ${lu_names:-none}): name one with --instance, or add it (lox add locklog $lu_inst) and run \`lox run\`"
			return 1
		fi
	else
		case "$lu_names" in
		"")
			lockup_why="lox run runs no locklog lock in $lu_ws: add one (lox add locklog <name>), then run \`lox run\` first"
			return 1
			;;
		*" "*)
			lockup_why="lox run runs several locklog locks in $lu_ws ($lu_names): name one with --instance NAME"
			return 1
			;;
		esac
		lu_sel=$lu_locks
	fi
	# shellcheck disable=SC2086 # name, volume and group: checked words
	set -- $lu_sel
	lu_name=$1 lu_sock=$2 lu_gid=${3:-}
	lu_vol=${lu_project}_$lu_name-run
	if [ "$lu_sock" != "$lu_vol" ]; then
		lockup_why="$lu_f: lock $lu_name: socket volume $lu_sock is not lox run's $lu_vol: run \`lox run\` first"
		return 1
	fi
	if [ -n "$lu_gid" ] && [ "$lu_gid" != 10050 ]; then
		lockup_why="lock $lu_name: clients group $lu_gid, this image's is 10050: update locklog (locklog update) or the lock's image"
		return 1
	fi
	lu_got=$(docker volume inspect --format '{{json (index .Labels "com.docker.compose.project")}}
{{json (index .Labels "com.docker.compose.volume")}}
{{json (index .Labels "dev.lockfamily.role")}}
{{json (index .Labels "dev.lockfamily.instance")}}
{{json (index .Labels "dev.lockfamily.type")}}
{{json (index .Labels "dev.lockfamily.workspace")}}' "$lu_vol" 2>/dev/null) || {
		lockup_why="lock $lu_name: no volume $lu_vol: run \`lox run\` first"
		return 1
	}
	if [ "$lu_got" != "\"$lu_project\"
\"$lu_name-run\"
\"socket\"
\"$lu_name\"
\"locklog\"
\"$lu_ws\"" ]; then
		lockup_why="lock $lu_name: volume $lu_vol is not lox run's socket volume of it (its labels): locklog trusts none of it; run \`lox run\` first"
		return 1
	fi
	# Every container that mounts the volume, running or not, must be lox
	# run's own or unable to serve a socket there. lox run's: compose ran
	# it from lox run's state directory, with the file on stdin or that
	# directory's compose.yaml (compose's project label alone is anyone's: a
	# compose file written in the workspace, run by you, would serve the
	# socket from an image of its own). Any other container, compose's or
	# not, must mount the volume read-only (an agent's, as this one): with
	# a read-write mount it could listen on the socket's path.
	lu_state_dir=$(printf '%s' "${XDG_STATE_HOME:-${HOME:-}/.local/state}/lockfamily/$lu_project" | sed -e 's#//*#/#g')
	if ! json_safe "$lu_state_dir"; then
		lockup_why="lox run's state directory $lu_state_dir holds a quote, a backslash or a control character: locklog cannot check lox run's containers"
		return 1
	fi
	lu_ids=$(docker ps -a --no-trunc --filter "volume=$lu_vol" --format '{{.ID}}' 2>/dev/null) || {
		lockup_why="lock $lu_name: cannot list the containers of $lu_vol (docker ps)"
		return 1
	}
	if [ -n "$lu_ids" ] && printf '%s\n' "$lu_ids" | grep -vqx '[0-9a-f]\{64\}'; then
		lockup_why="lock $lu_name: cannot read the containers of $lu_vol (docker ps)"
		return 1
	fi
	for lu_id in $lu_ids; do
		# Compose's project, working directory and files, as JSON; then
		# rw or ro for each mount of the volume (its name: checked
		# characters).
		lu_c=$(docker inspect --type container -f '{{json (index .Config.Labels "com.docker.compose.project")}}
{{json (index .Config.Labels "com.docker.compose.project.working_dir")}}
{{json (index .Config.Labels "com.docker.compose.project.config_files")}}
{{range .Mounts}}{{if eq .Name "'"$lu_vol"'"}}{{if .RW}}rw {{else}}ro {{end}}{{end}}{{end}}' "$lu_id" 2>/dev/null) || {
			lockup_why="lock $lu_name: cannot read the containers of $lu_vol (docker inspect $lu_id)"
			return 1
		}
		lu_rw=$(printf '%s\n' "$lu_c" | sed -n 4p)
		lu_c=$(printf '%s\n' "$lu_c" | sed -n 1,3p)
		if [ "$lu_c" = "\"$lu_project\"
\"$lu_state_dir\"
\"-\"" ] || [ "$lu_c" = "\"$lu_project\"
\"$lu_state_dir\"
\"$lu_state_dir/compose.yaml\"" ]; then
			continue # lox run's
		fi
		# Read-only mounts only (none listed: not one docker shows by name).
		case " $lu_rw" in
		" " | *" rw "*)
			lockup_why="lock $lu_name: volume $lu_vol is mounted read-write by container $lu_id, which lox run did not start (not compose run from $lu_state_dir): locklog trusts none of its socket; remove that container, then run \`lox run\`"
			return 1
			;;
		esac
	done
	lockup_vol=$lu_vol
}
lockup_vol='' lockup_why=''

# --instance NAME (or --instance=NAME): the launcher's own option of the
# agent commands, which of lox run's locklog locks when the workspace has
# several. Taken out of the command line ("--" ends the options).
instance=
case "${1:-}" in
mcp | doctor)
	n=$#
	take=
	done_opts=
	for a in "$@"; do
		if [ -n "$done_opts" ]; then
			set -- "$@" "$a"
			continue
		fi
		if [ -n "$take" ]; then
			instance=$a
			take=
			continue
		fi
		case "$a" in
		--) done_opts=1 ;;
		--instance)
			take=1
			continue
			;;
		--instance=*)
			instance=${a#--instance=}
			continue
			;;
		esac
		set -- "$@" "$a"
	done
	shift "$n"
	[ -z "$take" ] || die "--instance: name the lock (lox run's instance)"
	;;
esac

# lockup_mount: lox run's socket volume of this workspace's locklog lock,
# as the agent commands mount it, or the reason there is none (exit 2, as
# a client finding no console).
lockup_mount() {
	need_docker
	lockup_volume "$instance" || {
		say "$lockup_why"
		exit 2
	}
	mount="type=volume,src=$lockup_vol,dst=/run/locklog,readonly"
}

# check_tag TAG: TAG is a release tag (it goes into URLs and into the
# launcher's text).
check_tag() {
	printf '%s\n' "$1" | grep -Eqx 'v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?' ||
		die "invalid version $1: a release tag, vX.Y.Z"
}

# verified_digest TAG: the digest of the release image registry:TAG, once
# cosign verifies its signature by the release workflow; empty when it does
# not verify.
verified_digest() {
	cosign verify --certificate-identity "$identity" \
		--certificate-oidc-issuer https://token.actions.githubusercontent.com \
		"$registry:$1" 2>/dev/null |
		sed -n 's/.*"docker-manifest-digest":"\(sha256:[0-9a-f]\{64\}\)".*/\1/p' | sed -n 1p
}

# update [vX.Y.Z]: replace this launcher with a release's (the cosign
# signature of checksums.txt and the archive's checksum checked, as
# scripts/install.sh does), then pull that release's image.
update() {
	if [ -n "${1:-}" ]; then
		case "$1" in v*) check_tag "$1" ;; *) check_tag "v$1" ;; esac
	fi
	if command -v curl >/dev/null 2>&1; then
		fetch() { curl -fsSL --proto '=https' -o "$2" "$1"; }
		latest() { curl -fsSLI --proto '=https' -o /dev/null -w '%{url_effective}' "https://github.com/$repo/releases/latest"; }
	elif command -v wget >/dev/null 2>&1; then
		if wget --help 2>&1 | grep -q -- --https-only; then
			fetch() { wget -q --https-only -O "$2" "$1"; }
		else
			fetch() { wget -q -O "$2" "$1"; }
		fi
		latest() { wget -q -S --spider "https://github.com/$repo/releases/latest" 2>&1 | sed -n 's/^ *[Ll]ocation: *//p' | tail -n 1 | tr -d '\r'; }
	else
		die "curl or wget is required"
	fi
	case "$(uname -s)" in
	Linux) os=linux ;;
	Darwin) os=darwin ;;
	*) die "unsupported OS $(uname -s): Linux and macOS only" ;;
	esac
	case "$(uname -m)" in
	x86_64 | amd64) arch=amd64 ;;
	aarch64 | arm64) arch=arm64 ;;
	*) die "unsupported architecture $(uname -m): amd64 and arm64 only" ;;
	esac

	tag="${1:-${LOCKLOG_VERSION:-}}"
	if [ -z "$tag" ]; then
		tag="$(latest)" || tag=""
		tag="${tag##*/}"
		case "$tag" in
		v[0-9]*) ;;
		*) die "no published release found; name one: locklog update vX.Y.Z" ;;
		esac
	fi
	case "$tag" in v*) ;; *) tag="v$tag" ;; esac
	check_tag "$tag"
	version="${tag#v}"
	identity="https://github.com/$repo/.github/workflows/release.yml@refs/tags/$tag"
	if [ "$version" = "$launcher_version" ]; then
		say "the launcher is already $tag"
	else
		self="$(command -v "$0" 2>/dev/null || printf '%s' "$0")"
		archive="locklog_${version}_${os}_${arch}.tar.gz"
		base="https://github.com/$repo/releases/download/$tag"
		tmp="$(mktemp -d)"
		trap 'rm -rf "$tmp"' EXIT INT TERM
		say "downloading $archive ($tag)"
		fetch "$base/$archive" "$tmp/$archive" || die "download failed: $base/$archive"
		fetch "$base/checksums.txt" "$tmp/checksums.txt" || die "download failed: checksums.txt"
		command -v cosign >/dev/null 2>&1 ||
			die "cosign is required to check the release's signature (https://docs.sigstore.dev/cosign/system_config/installation/)"
		fetch "$base/checksums.txt.sigstore.json" "$tmp/checksums.txt.sigstore.json" ||
			die "download failed: checksums.txt.sigstore.json"
		cosign verify-blob --bundle "$tmp/checksums.txt.sigstore.json" \
			--certificate-identity "$identity" \
			--certificate-oidc-issuer https://token.actions.githubusercontent.com \
			"$tmp/checksums.txt" >/dev/null 2>&1 || die "cosign: signature of checksums.txt does not verify"
		say "cosign: checksums.txt signature verified"
		want="$(awk -v f="$archive" '$2 == f { print $1 }' "$tmp/checksums.txt")"
		[ -n "$want" ] || die "$archive is not listed in checksums.txt"
		if command -v sha256sum >/dev/null 2>&1; then
			got="$(sha256sum "$tmp/$archive" | awk '{ print $1 }')"
		else
			got="$(shasum -a 256 "$tmp/$archive" | awk '{ print $1 }')"
		fi
		[ "$want" = "$got" ] || die "checksum mismatch for $archive"
		tar -xzf "$tmp/$archive" -C "$tmp" scripts/locklog 2>/dev/null ||
			die "$archive holds no launcher (scripts/locklog)"
		digest="$(verified_digest "$version")"
		vdigest="$(verified_digest "$version-vault")"
		[ -n "$digest" ] && [ -n "$vdigest" ] && [ "$digest" != "$vdigest" ] ||
			die "cosign: the signature of $registry:$version (and -vault) does not verify, or the image is not published yet"
		say "cosign: image $registry:$version verified ($digest)"
		sed -e "s/^launcher_version=dev\$/launcher_version=$version/" \
			-e "s/^image_digest=\$/image_digest=$digest/" \
			-e "s/^vault_image_digest=\$/vault_image_digest=$vdigest/" \
			"$tmp/scripts/locklog" >"$tmp/launcher"
		grep -qx "launcher_version=$version" "$tmp/launcher" || die "the launcher of $tag does not take its version"
		if [ -w "$self" ]; then
			install -m 0755 "$tmp/launcher" "$self"
		else
			command -v sudo >/dev/null 2>&1 || die "$self is not writable and sudo is missing"
			say "replacing $self with sudo"
			sudo install -o root -m 0755 "$tmp/launcher" "$self"
		fi
		say "launcher updated to $tag ($self)"
		image="$registry@$digest"
		[ "${LOCKLOG_VAULT:-0}" = 1 ] && image="$registry@$vdigest"
		[ -n "${LOCKLOG_IMAGE:-}" ] && say "LOCKLOG_IMAGE is set ($LOCKLOG_IMAGE): it still overrides $image"
		rm -rf "$tmp"
		trap - EXIT INT TERM
	fi
	need_docker
	say "pulling $image"
	exec docker pull "$image"
}

# The project is mounted read-only at its own path in every container.
project_mount() {
	[ "$project" != / ] || die "run locklog from a project directory, not from /"
	safe "$project" || die "$project holds a character a docker mount cannot carry: move or rename it"
	safe "$workdir" || die "$workdir holds a character a docker mount cannot carry: move or rename it"
}

# The confinement every locklog container runs with.
confined="--cap-drop ALL --security-opt no-new-privileges --read-only --tmpfs /tmp:rw,nosuid,nodev,noexec,size=64m"

# write_facts FILE [logs]: the facts of this host and account that profile
# add and doctor read in the image (internal/hostfacts): ids, group names,
# states, paths and container names, never a log line or a secret. With
# "logs", the files under the log roots follow, NUL-delimited, last.
write_facts() {
	{
		echo 'locklog-facts 1'
		echo "euid $(id -u)"
		echo "groups $(id -Gn 2>/dev/null || :)"
		# id -Gn splits a group name with a space (SSSD, AD): each gid's
		# whole name, when getent has it, settles the names.
		gids=$(id -G 2>/dev/null) || gids=
		echo "gids $gids"
		if command -v getent >/dev/null 2>&1; then
			for g in $gids; do
				case "$g" in '' | *[!0-9]*) continue ;; esac
				ent=$(getent group "$g" 2>/dev/null) || ent=
				if [ -n "$ent" ]; then printf 'group %s %s\n' "$g" "${ent%%:*}"; fi
			done
		fi
		if ! command -v sudo >/dev/null 2>&1; then
			echo 'sudo absent'
		elif sudo -n true >/dev/null 2>&1; then
			echo 'sudo nopasswd'
		else
			echo 'sudo password'
		fi
		if [ -n "${DOCKER_HOST:-}" ]; then echo 'docker_host set'; fi
		dk=
		if docker version --format '{{.Server.Version}}' >/dev/null 2>&1; then
			dk=1
			echo 'docker reachable'
		else
			echo 'docker unreachable'
		fi
		for p in /var/log/journal /var/lib/docker; do
			[ -e "$p" ] || continue
			if ls "$p" >/dev/null 2>&1; then echo "readable $p"; else echo "unreadable $p"; fi
		done
		if [ -n "${HOME:-}" ]; then
			for c in .aws/credentials .config/gcloud/application_default_credentials.json .azure/msal_token_cache.json .azure/accessTokens.json; do
				if [ -f "$HOME/$c" ]; then echo "credfile ~/$c"; fi
			done
		fi
		for j in /var/log/journal /run/log/journal; do
			if [ -d "$j" ] && [ ! -L "$j" ]; then echo "journal $j"; fi
		done
		# The agents, as lockkit's agentwire detects them.
		if command -v claude >/dev/null 2>&1; then echo 'agent claude'; fi
		if command -v codex >/dev/null 2>&1 || [ -d "${CODEX_HOME:-${HOME:-/nonexistent}/.codex}" ]; then echo 'agent codex'; fi
		if command -v cursor >/dev/null 2>&1 || command -v cursor-agent >/dev/null 2>&1 || [ -d "${HOME:-/nonexistent}/.cursor" ]; then echo 'agent cursor'; fi
		if command -v gemini >/dev/null 2>&1 || [ -d "${HOME:-/nonexistent}/.gemini" ]; then echo 'agent gemini'; fi
		if [ -n "$dk" ]; then
			docker ps --format '{{.Names}} {{.Image}} {{with .Label "com.docker.compose.service"}}{{.}}{{else}}-{{end}} {{with .Label "com.docker.compose.project"}}{{.}}{{else}}-{{end}} {{with .Networks}}{{.}}{{else}}-{{end}}' 2>/dev/null |
				sed 's/^/container /' || :
			for cid in $(docker ps -q 2>/dev/null || :); do
				rec=$(docker inspect --type container --format '{{.HostConfig.IpcMode}} {{.Name}}' "$cid" 2>/dev/null) || continue
				case "$rec" in "shareable /"*) echo "ipc_shareable ${rec#shareable /}" ;; esac
			done
			sw=$(docker info --format '{{.Swarm.LocalNodeState}}' 2>/dev/null) || sw=
			case "$sw" in '' | *[!a-z-]*) ;; *) echo "swarm $sw" ;; esac
		fi
		if [ "${2:-}" = logs ]; then
			# NUL-delimited, last: a newline in a name cannot forge a path.
			echo logs0
			set -f
			# shellcheck disable=SC2086 # the roots are split on purpose
			find $roots -maxdepth 3 -type f -print0 2>/dev/null || :
			set +f
		fi
	} >"$1"
}

# profile_add ARGS: `locklog profile add` in the image, as you (your uid and
# gid, so that .locklog/ is yours), with the project writable (the one
# --project DIR names, passed on as an absolute path; else this project),
# the host's facts, and the directory of the proxies' files (outside the
# project, 0700); no network. The trusted .locklog/ is checked here
# afterwards, as lox run's review will.
profile_add() {
	need_docker
	pa=$project
	n=$#
	take=
	done_opts=
	for a in "$@"; do
		if [ -n "$done_opts" ]; then
			set -- "$@" "$a"
			continue
		fi
		if [ -n "$take" ]; then
			a=--project=$a
			take=
		fi
		case "$a" in
		--) done_opts=1 ;;
		--project)
			take=1
			continue
			;;
		--project=*)
			p=${a#--project=}
			[ -n "$p" ] && [ -d "$p" ] || die "--project: not a directory"
			pa=$(cd "$p" && pwd -P) || die "--project: not a directory"
			a=--project=$pa
			;;
		esac
		set -- "$@" "$a"
	done
	shift "$n"
	[ -z "$take" ] || die "--project: name the project directory"
	[ "$pa" != / ] || die "run locklog from a project directory, not from /"
	safe "$pa" || die "$pa holds a character a docker mount cannot carry: move or rename it"
	shared "$pa" && die "$pa is writable by someone else than you, or not yours: add the profile in a project directory of your own"
	[ -z "$home_dir" ] || [ "$pa" != "$home_dir" ] || die "run locklog profile add in a project directory, not in your home directory"
	cfg_home=${XDG_CONFIG_HOME:-}
	case "$cfg_home" in /*) ;; *) [ -n "${HOME:-}" ] || die "HOME is not set"; cfg_home=$HOME/.config ;; esac
	proxy_dir=$cfg_home/locklog/proxy
	(umask 077 && mkdir -p "$proxy_dir") || die "could not create $proxy_dir"
	proxy_dir=$(cd "$proxy_dir" && pwd -P) || die "could not enter $proxy_dir"
	safe "$proxy_dir" || die "$proxy_dir holds a character a docker mount cannot carry"
	trusted "$proxy_dir" || die "$proxy_dir is a link, has an ACL, or is owned or writable by someone else than you"
	facts=$(mktemp) || die "mktemp failed"
	chmod 0600 "$facts" || die "could not restrict $facts"
	trap 'rm -f "$facts"' EXIT
	trap 'exit 130' INT
	trap 'exit 143' TERM
	write_facts "$facts" logs
	rc=0
	docker run --rm "$tty" --user "$(id -u):$(id -g)" --log-driver none --network none $confined \
		--pids-limit 64 --memory 256m -e "LOCKLOG_HOST_HOME=$home_dir" \
		-v "$pa:$pa" -v "$proxy_dir:$proxy_dir" -v "$facts:/run/locklog-facts:ro" -w "$pa" \
		"$image" profile add --facts /run/locklog-facts --proxy-dir "$proxy_dir" "$@" || rc=$?
	[ "$rc" -eq 0 ] || exit "$rc"
	trusted_config "$pa" ||
		die "$pa/.locklog or its config.toml is a link, has an ACL, or is writable by someone else than you: fix it before lox run"
}

# agent_root: the project an agent is wired in (lockkit's agentwire): the
# nearest directory up from here with a .locklog/, else with a .git, else
# this directory.
agent_root() {
	ar=$here
	d=$here
	while :; do
		if [ -d "$d/.locklog" ] && [ ! -L "$d/.locklog" ]; then
			ar=$d
			return 0
		fi
		[ "$d" = / ] && break
		d=$(dirname "$d")
	done
	d=$here
	while :; do
		if [ -e "$d/.git" ]; then
			ar=$d
			return 0
		fi
		[ "$d" = / ] && break
		d=$(dirname "$d")
	done
}

# as_you ARGS: `locklog init` (and `doctor --fix`'s wiring) in the image, as
# you (the agent files are yours), with the project an agent is wired in
# writable at its own path; no network.
as_you() {
	need_docker
	agent_root
	[ "$ar" != / ] || die "run locklog from a project directory, not from /"
	safe "$ar" || die "$ar holds a character a docker mount cannot carry: move or rename it"
	safe "$here" || die "$here holds a character a docker mount cannot carry: move or rename it"
	exec docker run --rm "$tty" --user "$(id -u):$(id -g)" --log-driver none --network none $confined \
		--pids-limit 64 --memory 256m -v "$ar:$ar" -w "$here" "$image" "$@"
}

# doctor ARGS: `locklog doctor` in the image as the agent account, with the
# host's facts on its input, the project read-only, the host's network (its
# probes see what an agent here reaches) and, when `lox run` runs the
# workspace's locklog lock, its socket volume read-only. Advisory: it never
# prints a response body.
doctor() {
	need_docker
	project_mount
	fix=
	for a in "$@"; do
		case "$a" in --) break ;; --fix | --fix=*) fix=1 ;; esac
	done
	sock=
	if lockup_volume "$instance"; then
		sock="type=volume,src=$lockup_vol,dst=/run/locklog,readonly"
	else
		say "$lockup_why"
	fi
	facts=$(mktemp) || die "mktemp failed"
	chmod 0600 "$facts" || die "could not restrict $facts"
	trap 'rm -f "$facts"' EXIT
	trap 'exit 130' INT
	trap 'exit 143' TERM
	write_facts "$facts"
	rc=0
	if [ -n "$fix" ]; then
		# --fix wires your agents: it writes their files in the project, as
		# you. It asks on the terminal unless --yes: the facts go in a file.
		agent_root
		safe "$ar" || die "$ar holds a character a docker mount cannot carry: move or rename it"
		docker run --rm "$tty" --user "$(id -u):$(id -g)" --log-driver none --network host $confined --pids-limit 64 --memory 256m \
			${sock:+--mount} ${sock:+"$sock"} -v "$ar:$ar" -v "$facts:/run/locklog-facts:ro" -w "$here" \
			"$image" doctor --facts /run/locklog-facts "$@" || rc=$?
		exit "$rc"
	fi
	# The facts go on stdin: the agent account cannot read your 0600 file.
	docker run --rm -i --user agent --log-driver none --network host $confined --pids-limit 64 --memory 256m \
		${sock:+--mount} ${sock:+"$sock"} -v "$project:$project:ro" -w "$workdir" \
		"$image" doctor --facts - "$@" <"$facts" || rc=$?
	exit "$rc"
}

cmd="${1:-}"
case "$cmd" in
update)
	shift
	update "$@"
	;;
version | --version)
	printf 'locklog launcher %s (image %s)\n' "$launcher_version" "$image"
	need_docker
	exec docker run --rm --network none --user agent $confined "$image" version
	;;
console | hub-key)
	# The console runs hub-attached only, started by lox run with its hub
	# flags, its mounts and its home: never from this launcher.
	say "locklog $cmd is run by \`lox run\` only (lockhub): add the lock with \`lox add locklog <name>\`, then run \`lox run\` in a terminal of its own"
	exit 2
	;;
profile)
	if [ "${2:-}" = add ]; then
		shift 2
		profile_add "$@"
		exit 0
	fi
	need_docker
	project_mount
	if [ "${2:-}" = rules ]; then
		# The auto rules of the project's profiles (read by lox run): as
		# the agent account, the project read-only, no network, no volume
		# (the rules of the config file; the console's approved ones are
		# in its home volume).
		exec docker run --rm --user agent --log-driver none --network none $confined \
			-v "$project:$project:ro" -w "$workdir" "$image" "$@"
	fi
	exec docker run --rm "$tty" --user agent --log-driver none --network none $confined "$image" "$@"
	;;
init)
	as_you "$@"
	;;
doctor)
	shift
	doctor "$@"
	;;
mcp)
	# The agent speaks MCP on stdin and stdout: no terminal. The server
	# refuses a production profile when LOCKLOG_HOST_AGENT is set: a host
	# agent is the non-production trial.
	project_mount
	lockup_mount
	exec docker run --rm -i --user agent --log-driver none --network none $confined \
		--pids-limit 64 --memory 256m -e LOCKLOG_HOST_AGENT=1 \
		--mount "$mount" -v "$project:$project:ro" -w "$workdir" "$image" "$@"
	;;
*)
	need_docker
	project_mount
	exec docker run --rm "$tty" --user agent --log-driver none --network none $confined \
		-v "$project:$project:ro" -w "$workdir" "$image" "$@"
	;;
esac
