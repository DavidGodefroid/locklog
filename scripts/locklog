#!/bin/sh
# locklog: the launcher. locklog runs in Docker; this script, installed as
# `locklog` on the host by scripts/install.sh, runs every command in the
# image, each with the account, the mounts and the network it needs:
#
#   console    as the console account (locklog, uid 10051), in a container
#              of its own per project (locklog-console-<n>, labelled
#              locklog.console=1): no capability, read-only root, bounded
#              CPU, memory and processes, no log driver, no network unless
#              LOCKLOG_NETWORK names one; the log directories of the
#              profile's mount plan bound read-only and non-recursive; the
#              socket and home volumes. With a docker source: the Docker
#              containers root bound read-only and non-recursive with gid 0,
#              and the containers map (below) kept current by a `docker
#              events` loop for the console's lifetime. gid 0 applies to the
#              whole console, not to one mount: a docker source therefore
#              runs in a console of its own, with no file or journald
#              source beside it (remote sources are fine)
#   refresh    rewrite the containers map of this project's console once
#   setup      as you, in the image: the trusted .locklog/ and its
#              config.toml from this host's facts (log files, journal,
#              containers, agents), the agent's project wiring or the
#              own-container recipe, a Compose Loki's proxy (its files in
#              ~/.config/locklog/proxy, outside the project)
#   doctor     as the agent account, with the host's network: what an
#              agent here can reach (advisory)
#   mcp       as the image's agent account (uid 10052): the MCP server of
#              a host agent (the non-production trial; the server refuses
#              production profiles), with the socket volume and the
#              project (read-only)
#   update     replace this launcher with a release's, then pull its image
#   version    this launcher's and the image's versions
#   anything else  as the agent account, with the socket volume
#
# The project (the nearest directory up from here that holds .locklog/, or
# this directory) is mounted read-only at its own path.
#
# The containers map: the name -> id map of the containers the approved
# globs of the profile's docker sources name, written here (the console has
# no engine socket to ask). One file per version, map.v<N> (0644, in a 0755
# directory), in $XDG_RUNTIME_DIR/locklog/map/<console>/, else in
# ~/.local/state/locklog/map/<console>/, bound read-only at /run/locklog-map:
#
#   locklog-map 1
#   c <64-hex id> <name> <max-file 1..100> <compress 0|1>   a json-file container
#   x <64-hex id>                                           a console container: never served
#
# Names and ids only, never log content. The console checks the globs again
# when it reads, and skips console containers whatever the map says.
#
# Environment:
#   LOCKLOG_IMAGE        image to run (default: the release image of this
#                        launcher's version; `locklog` for a launcher run
#                        from a clone, the tag of `docker build -t locklog .`)
#   LOCKLOG_VAULT=1      the image with the vault CLI (credentials = "vault")
#   LOCKLOG_NETWORK      a Docker network the console joins to reach a
#                        backend (default: none). Agents must not join it.
#   LOCKLOG_EXTRA_ROOTS  log directories beyond the built-in allowlist
#                        (/var/log, /run/log/journal), separated by spaces
#   VAULT_ADDR, VAULT_NAMESPACE  passed to the console
#   XDG_RUNTIME_DIR      where the containers map is written, when it is a
#                        directory of yours
set -eu

# scripts/install.sh and locklog update write the release version here,
# and the digests of its images once their cosign signatures verify: the
# launcher then runs the image by digest, never by a tag that could move.
launcher_version=dev
image_digest=
vault_image_digest=

repo="DavidGodefroid/locklog"
registry="ghcr.io/davidgodefroid/locklog"

say() { printf 'locklog: %s\n' "$*" >&2; }
die() {
	say "$*"
	exit 1
}

image="${LOCKLOG_IMAGE:-}"
if [ -z "$image" ]; then
	if [ "$launcher_version" = dev ]; then
		image=locklog
	else
		image="$registry:$launcher_version"
	fi
	if [ "$launcher_version" != dev ] && [ -n "$image_digest" ]; then
		image="$registry@$image_digest"
		[ "${LOCKLOG_VAULT:-0}" = 1 ] && image="$registry@$vault_image_digest"
	elif [ "${LOCKLOG_VAULT:-0}" = 1 ]; then
		case "$image" in
		*:*) image="$image-vault" ;;
		*) image="$image:vault" ;;
		esac
	fi
fi

tty=-i
if [ -t 0 ] && [ -t 1 ]; then tty=-it; fi

need_docker() {
	command -v docker >/dev/null 2>&1 || die "docker is required: locklog runs in Docker"
}

# safe PATH: PATH holds none of the characters a docker -v or --mount spec,
# the LOCKLOG_EXPECT_ROOTS list (entries "dev:inode path;") or the mount
# plan cannot carry.
safe() {
	case "$1" in
	*[,=:\;\"\'\`\\]* | *"
"*) return 1 ;;
	esac
	printf '%s' "$1" | LC_ALL=C grep -q '[[:cntrl:]]' && return 1
	return 0
}

# physical DIR: DIR is an existing directory whose physical path is itself
# (no symbolic link on its path, no "..").
physical() {
	[ -d "$1" ] && [ ! -L "$1" ] && [ "$(cd "$1" 2>/dev/null && pwd -P)" = "$1" ]
}

# Portable stat: the device:inode, the numeric group, the group name and
# the octal mode of PATH.
if [ "$(uname -s)" = Darwin ]; then
	devino() { stat -f '%d:%i' "$1"; }
	fgid() { stat -f '%g' "$1"; }
	fgroup() { stat -f '%Sg' "$1"; }
	fmode() { stat -f '%Mp%Lp' "$1"; }
else
	devino() { stat -c '%d:%i' "$1"; }
	fgid() { stat -c '%g' "$1"; }
	fgroup() { stat -c '%G' "$1"; }
	fmode() { stat -c '%a' "$1"; }
fi

# bits PATH WHO WANT: whether the mode of PATH grants WANT (r, x or rx) to
# WHO (g or o).
bits() {
	m=000$(fmode "$1")
	m=${m#"${m%???}"} # the last three octal digits
	case "$2" in
	g) v=$(printf '%s' "$m" | cut -c2) ;;
	o) v=$(printf '%s' "$m" | cut -c3) ;;
	esac
	case "$3" in
	r) [ $((v & 4)) -ne 0 ] ;;
	x) [ $((v & 1)) -ne 0 ] ;;
	rx) [ $((v & 5)) -eq 5 ] ;;
	esac
}

# The groups the console may join to read logs: never a group outside this
# list (gid 0 is not on it: no root-owned log is read through it here).
group_allowed() {
	case "$1" in
	adm | systemd-journal) return 0 ;;
	esac
	return 1
}

# fowner PATH: the numeric owner of PATH.
if [ "$(uname -s)" = Darwin ]; then
	fowner() { stat -f '%u' "$1"; }
else
	fowner() { stat -c '%u' "$1"; }
fi

# perm PATH: sets special (setuid/setgid/sticky digit), g and o (the
# group's and the others' digits) from the octal mode of PATH.
perm() {
	m=000$(fmode "$1")
	l=${m#"${m%???}"}
	sp=${m%???}
	special=${sp#"${sp%?}"}
	g=$(printf '%s' "$l" | cut -c2)
	o=$(printf '%s' "$l" | cut -c3)
}

# has_acl PATH: PATH carries an access control list ("+" after the mode
# in ls -ld): its mode bits do not say who can write it.
has_acl() {
	if [ "$(uname -s)" = Darwin ]; then
		# macOS prints "@" over "+" when there are xattrs too: ls -le lists
		# the ACL entries themselves, after the first line.
		[ -n "$(ls -lde "$1" 2>/dev/null | sed -n 2p)" ]
		return
	fi
	case "$(ls -ld "$1" 2>/dev/null | cut -c11)" in
	+) return 0 ;;
	esac
	return 1
}

# mine PATH: PATH is owned by you or by root.
mine() {
	ow=$(fowner "$1")
	[ "$ow" = "$(id -u)" ] || [ "$ow" = 0 ]
}

# trusted PATH: PATH is not a symbolic link, is owned by you or root, has
# no ACL, and no one else can write it.
trusted() {
	[ -e "$1" ] && [ ! -L "$1" ] || return 1
	mine "$1" || return 1
	has_acl "$1" && return 1
	perm "$1"
	[ $((g & 2)) -eq 0 ] && [ $((o & 2)) -eq 0 ]
}

# shared DIR: DIR is writable by others than its owner, sticky (/tmp),
# owned by someone else than you or root, or under an ACL: someone else
# could have created, or could replace, a .locklog/ in it.
shared() {
	mine "$1" || return 0
	has_acl "$1" && return 0
	perm "$1"
	[ $((special & 1)) -ne 0 ] || [ $((g & 2)) -ne 0 ] || [ $((o & 2)) -ne 0 ]
}

# trusted_config DIR: DIR/.locklog is a trusted directory, and its
# config.toml (when present) a trusted file.
trusted_config() {
	[ -d "$1/.locklog" ] && trusted "$1/.locklog" || return 1
	[ ! -e "$1/.locklog/config.toml" ] && [ ! -L "$1/.locklog/config.toml" ] && return 0
	[ -f "$1/.locklog/config.toml" ] && trusted "$1/.locklog/config.toml"
}

# The project root: the nearest directory up from here that holds a
# .locklog/ you own (or root does) and no one else can write, with its
# config.toml likewise. The walk never goes above your home directory (when
# here is in it), never past a directory others can write or a sticky one
# (/tmp), and never takes / itself: a .locklog/ someone else planted there
# would choose the logs the console serves.
#
# project_trusted is set only when the walk accepted a .locklog/: console
# refuses to start without it. Other commands run with this directory as
# the project then (mounted read-only).
here="$(pwd -P)"
project="$here"
project_trusted=
home_dir=
if [ -n "${HOME:-}" ]; then home_dir="$(cd "$HOME" 2>/dev/null && pwd -P)" || home_dir=; fi
d="$here"
while :; do
	[ "$d" = / ] && break
	if [ -e "$d/.locklog" ] || [ -L "$d/.locklog" ]; then
		if ! shared "$d" && trusted_config "$d"; then
			project="$d"
			project_trusted=1
		else
			say "warning: ignoring $d/.locklog: it, its config.toml or $d is a link, has an ACL, or is owned or writable by someone else than you"
		fi
		break
	fi
	shared "$d" && break
	[ -n "$home_dir" ] && [ "$d" = "$home_dir" ] && break
	d="$(dirname "$d")"
done
case "$here" in
"$project" | "$project"/*) workdir=$here ;;
*) workdir=$project ;;
esac

# The roots log directories may be bound from.
roots="/var/log /run/log/journal"
# Split on spaces, never globbed.
set -f
for r in ${LOCKLOG_EXTRA_ROOTS:-}; do
	case "$r" in
	/) die "LOCKLOG_EXTRA_ROOTS: / cannot be a log root" ;;
	/*) ;;
	*) die "LOCKLOG_EXTRA_ROOTS: $r is not an absolute path" ;;
	esac
	case "$r" in *[*?[]*) die "LOCKLOG_EXTRA_ROOTS: $r holds a glob character" ;; esac
	safe "$r" || die "LOCKLOG_EXTRA_ROOTS: $r holds a character a mount cannot carry"
	physical "$r" || die "LOCKLOG_EXTRA_ROOTS: $r is not a directory with no symbolic link on its path"
	roots="$roots $r"
done
set +f

under_root() {
	for r in $roots; do
		case "$1" in
		"$r" | "$r"/*) return 0 ;;
		esac
	done
	return 1
}

# The mount plan, filled by plan_line: the --mount and --group-add
# arguments, the dev:inode of each root, and the plan text printed before
# docker run.
mount_args=
gids=
expect=
plan_text=
seen_dirs=

add_gid() {
	case " $gids " in
	*" $1 "*) ;;
	*) gids="$gids $1" ;;
	esac
}

# bind DIR: bind DIR read-only and non-recursive at its own path, once.
bind() {
	case " $seen_dirs " in
	*" $1 "*) return 0 ;;
	esac
	seen_dirs="$seen_dirs $1"
	mount_args="$mount_args --mount type=bind,src=$1,dst=$1,readonly,$nonrecursive"
	expect="$expect$(devino "$1") $1;"
	plan_text="$plan_text  bind $1 (read-only, non-recursive)
"
}

# reach DIR [FILE]: the gid the console needs to list DIR (no FILE), or to
# search DIR and read FILE, added when it is an allowed group; nothing when
# the others' bits suffice; a warning otherwise.
reach() {
	dir=$1
	file=${2:-}
	if [ -z "$file" ]; then
		bits "$dir" o rx && return 0
		gn=$(fgroup "$dir")
		if group_allowed "$gn" && bits "$dir" g rx; then
			add_gid "$(fgid "$dir")"
			return 0
		fi
		say "warning: the console cannot list $dir (group $gn is not one it may join: adm, systemd-journal)"
		return 0
	fi
	bits "$dir" o x && bits "$file" o r && return 0
	fg=$(fgid "$file")
	gn=$(fgroup "$file")
	# Through the file's group: it must also let that group search the
	# directory, unless the others may.
	if group_allowed "$gn" && bits "$file" g r &&
		{ bits "$dir" o x || { [ "$(fgid "$dir")" = "$fg" ] && bits "$dir" g x; }; }; then
		add_gid "$fg"
		return 0
	fi
	say "warning: the console cannot read $file (group $gn is not one it may join: adm, systemd-journal)"
}

# plan_line LINE: one line of `locklog mounts`.
plan_line() {
	set -f
	# shellcheck disable=SC2086 # split on purpose
	set -- $1
	set +f
	case "${1:-}" in
	file)
		[ $# -eq 3 ] || die "mount plan: malformed line: file $*"
		local_lines=1
		dir=$2
		glob=$3
		safe "$dir" && safe "$glob" || die "mount plan: $dir holds a character a mount cannot carry"
		case "$dir" in /) die "mount plan: / cannot be bound" ;; /*) ;; *) die "mount plan: $dir is not absolute" ;; esac
		case "$glob" in "$dir"/*) ;; *) die "mount plan: $glob is not under $dir" ;; esac
		case "$glob/" in *//* | */./* | */../*) die "mount plan: $glob is not a clean path" ;; esac
		physical "$dir" || die "mount plan: $dir is not a directory with no symbolic link on its path"
		under_root "$dir" || die "mount plan: $dir is not under an allowed log root ($roots); a human can add one with LOCKLOG_EXTRA_ROOTS"
		bind "$dir"
		reach "$dir"
		# The files the glob names today (not ** globs, which sh does not
		# expand): each one readable through an allowed group.
		case "$glob" in
		*'**'*) ;;
		*)
			for f in $glob; do
				[ -f "$f" ] && [ ! -L "$f" ] || continue
				fd=$(dirname "$f")
				reach "$fd" "$f"
			done
			;;
		esac
		;;
	docker)
		[ $# -eq 2 ] || die "mount plan: malformed line: $*"
		add_docker_glob "$2"
		;;
	journald)
		[ $# -eq 1 ] || die "mount plan: malformed line: $*"
		local_lines=1
		found=
		for j in /var/log/journal /run/log/journal; do
			physical "$j" || continue
			found=1
			bind "$j"
			reach "$j"
		done
		[ -n "$found" ] || say "warning: no journal directory (/var/log/journal, /run/log/journal) on this host"
		;;
	*)
		die "mount plan: unknown line: $*"
		;;
	esac
}

# The approved container globs of the docker sources (one per line, from the
# plan's docker lines), the containers root once bound, and whether the plan
# binds other log directories (file, journald lines).
docker_globs=
docker_root=
local_lines=

# add_docker_glob GLOB: a container name glob ([A-Za-z0-9_.*?-], as the
# config allows), once.
add_docker_glob() {
	case "$1" in
	'' | -* | *[!A-Za-z0-9_.*?-]*) die "mount plan: invalid container glob $1" ;;
	esac
	case "
$docker_globs" in
	*"
$1
"*) ;;
	*) docker_globs="$docker_globs$1
" ;;
	esac
}

# docker_root_bind: bind the Docker containers root (docker info
# .DockerRootDir + /containers) read-only and non-recursive at its own path,
# and add gid 0 (its directories are 0710 root:root, the json logs 0640,
# and rotated files appear later: no narrower grant works). A supplementary
# gid applies to the whole console process, not to one mount: with gid 0 the
# console could read any file readable by group root in any of its mounts.
# So gid 0 is added only when nothing else is bound: no file or journald
# line (refused beside a docker line, here and by `locklog mounts`), only
# the project's .locklog/ (read-only, yours), the locklog volumes and the
# map directory (0644 files you wrote). The daemon is trusted for this path.
# You usually cannot reach it (/var/lib/docker is 0710 root), so its
# dev:inode is passed to the console only when you can stat it.
docker_root_bind() {
	[ -z "$local_lines" ] && [ -z "$mount_args" ] && [ -z "$seen_dirs" ] && [ -z "$gids" ] ||
		die "a docker source cannot share a console with file or journald sources: the containers root is read with group 0, which would apply to every bound log directory; put the container logs in a profile of their own and run a separate console for them"
	dr=$(docker info --format '{{.DockerRootDir}}' 2>/dev/null) || die "could not read the Docker root directory (docker info)"
	r="${dr%/}/containers"
	case "$r" in /?*) ;; *) die "the Docker root directory $dr is not an absolute path" ;; esac
	case "$r/" in *//* | */./* | */../*) die "the Docker root directory $dr is not a clean path" ;; esac
	case "$r" in *[*?[\ ]*) die "the Docker root directory $dr holds a space or a glob character" ;; esac
	safe "$r" || die "the Docker root directory $dr holds a character a mount cannot carry"
	docker_root=$r
	mount_args="$mount_args --mount type=bind,src=$r,dst=$r,readonly,$nonrecursive"
	add_gid 0
	if di=$(devino "$r" 2>/dev/null) && [ -n "$di" ]; then
		expect="$expect$di $r;"
		plan_text="$plan_text  bind $r (read-only, non-recursive; the Docker containers root, group 0 for it only)
"
	else
		plan_text="$plan_text  bind $r (read-only, non-recursive; the Docker containers root, group 0 for it only; owned by root: not checked from the host)
"
	fi
}

valid_id() {
	[ ${#1} -eq 64 ] || return 1
	case "$1" in *[!0-9a-f]*) return 1 ;; esac
	return 0
}

valid_name() {
	[ ${#1} -le 128 ] || return 1
	case "$1" in '' | [!A-Za-z0-9]* | *[!A-Za-z0-9_.-]*) return 1 ;; esac
	return 0
}

is_console() {
	case "$1" in locklog-console*) return 0 ;; esac
	return 1
}

# glob_match NAME: NAME matches one of docker_globs (as sh patterns: the
# globs hold no special character but '*' and '?').
glob_match() {
	while IFS= read -r g; do
		[ -n "$g" ] || continue
		# shellcheck disable=SC2254 # the glob is a pattern on purpose
		case "$1" in $g) return 0 ;; esac
	done <<EOF
$docker_globs
EOF
	return 1
}

# map_base: the directory of the containers maps.
map_base() {
	x=${XDG_RUNTIME_DIR:-}
	if [ -n "$x" ] && [ -d "$x" ] && [ ! -L "$x" ] && [ "$(fowner "$x")" = "$(id -u)" ]; then
		printf '%s/locklog/map\n' "$x"
		return 0
	fi
	[ -n "${HOME:-}" ] || die "neither XDG_RUNTIME_DIR nor HOME is set: no place for the containers map"
	printf '%s/.local/state/locklog/map\n' "$HOME"
}

# ensure_map_dir NAME: set map_dir, the containers map directory of the
# console NAME: yours, 0755, no symbolic link, created (its parents 0700)
# when missing.
ensure_map_dir() {
	base=$(map_base)
	(umask 077 && mkdir -p "$base") || die "could not create $base"
	d="$base/$1"
	[ ! -L "$d" ] || die "$d is a symbolic link"
	mkdir -p "$d" || die "could not create $d"
	chmod 0755 "$d"
	map_dir=$(cd "$d" && pwd -P) || die "could not enter $d"
	case "$map_dir" in *" "*) die "$map_dir holds a space: a mount cannot carry it" ;; esac
	safe "$map_dir" || die "$map_dir holds a character a mount cannot carry"
	trusted "$map_dir" || die "$map_dir is a link, has an ACL, or is owned or writable by someone else than you"
}

# write_map: write the next version of the containers map into map_dir,
# atomically (a temporary file in the same directory, then mv), under the
# directory's writer lock, and keep the last two versions. Sets map_version, map_c (containers mapped), map_x
# (console containers excluded) and map_skip (matching containers skipped:
# not json-file, or a record that does not parse).
#
# Nothing the engine prints is split on a separator a name, a label or a log
# option could hold: the ids come from `docker ps -q` (validated, each once;
# an id listed twice is excluded), and each container is inspected alone,
# the label as a fixed token from a template conditional, the free-text
# fields validated token by token, the name last; a record of another line
# or field count, or another id, is excluded too (fail closed: an x line).
lock_held=

# map_lock: take the map directory's writer lock (mkdir is atomic), so that
# refresh and the loop never race on N or on each other's temporary file.
# A lock older than a minute is a killed writer's: broken. Waits up to 15 s.
map_lock() {
	i=0
	while ! mkdir "$map_dir/.lock" 2>/dev/null; do
		if [ -n "$(find "$map_dir/.lock" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then
			rmdir "$map_dir/.lock" 2>/dev/null || :
			continue
		fi
		i=$((i + 1))
		[ "$i" -le 15 ] || return 1
		sleep 1
	done
	lock_held=1
}

map_unlock() {
	rmdir "$map_dir/.lock" 2>/dev/null || :
	lock_held=
}

# lock_traps: release the writer lock when this shell exits or is
# signalled while holding it.
lock_traps() {
	trap '[ -z "$lock_held" ] || rmdir "$map_dir/.lock" 2>/dev/null || :' EXIT
	trap 'exit 129' HUP
	trap 'exit 130' INT
	trap 'exit 143' TERM
}

write_map() {
	if [ ! -d "$map_dir" ]; then
		{ mkdir -p "$map_dir" && chmod 0755 "$map_dir"; } || return 1
	fi
	map_lock || return 1
	wm_rc=0
	write_map_locked || wm_rc=$?
	map_unlock
	return "$wm_rc"
}

write_map_locked() {
	set +f
	# Temporary files a killed writer left behind (older than a minute).
	find "$map_dir" -maxdepth 1 -name '.map.tmp.*' -type f -mmin +1 -exec rm -f {} + 2>/dev/null || :
	ids=$(docker ps -a -q --no-trunc) || return 1
	cs=
	xs=
	map_c=0
	map_x=0
	map_skip=0
	seen=
	dups=
	while IFS= read -r cid; do
		valid_id "$cid" || continue
		case " $seen " in
		*" $cid "*) dups="$dups $cid" ;;
		*) seen="$seen $cid" ;;
		esac
	done <<EOF
$ids
EOF
	set -f
	for cid in $seen; do
		case " $dups " in
		*" $cid "*)
			xs="${xs}x $cid
"
			map_x=$((map_x + 1))
			continue
			;;
		esac
		rec=$(docker inspect --type container --format '{{.Id}} {{if index .Config.Labels "locklog.console"}}1{{else}}0{{end}} {{.HostConfig.LogConfig.Type}} {{with index .HostConfig.LogConfig.Config "max-file"}}{{.}}{{else}}-{{end}} {{with index .HostConfig.LogConfig.Config "compress"}}{{.}}{{else}}-{{end}} {{.Name}}' "$cid" 2>/dev/null) || continue # gone since the listing
		bad=
		case "$rec" in *"
"*) bad=1 ;; esac
		if [ -z "$bad" ]; then
			# shellcheck disable=SC2086 # split on purpose (set -f)
			set -- $rec
			[ $# -eq 6 ] && [ "$1" = "$cid" ] || bad=1
		fi
		if [ -z "$bad" ]; then
			label=$2
			ctype=$3
			mf=$4
			cmp=$5
			cname=${6#/}
			case "$label" in 0 | 1) ;; *) bad=1 ;; esac
			valid_name "$cname" || bad=1
		fi
		if [ -n "$bad" ] || [ "$label" = 1 ] || is_console "$cname"; then
			xs="${xs}x $cid
"
			map_x=$((map_x + 1))
			[ -z "$bad" ] || map_skip=$((map_skip + 1))
			continue
		fi
		glob_match "$cname" || continue
		case "$ctype" in
		json-file) ;;
		*)
			map_skip=$((map_skip + 1))
			continue
			;;
		esac
		case "$mf" in
		-) mf=1 ;;
		'' | *[!0-9]*)
			map_skip=$((map_skip + 1))
			continue
			;;
		esac
		while :; do
			case "$mf" in 0?*) mf=${mf#0} ;; *) break ;; esac
		done
		if [ ${#mf} -gt 3 ] || [ "$mf" -gt 100 ]; then mf=100; fi
		[ "$mf" -ge 1 ] || mf=1
		case "$cmp" in
		true) cmp=1 ;;
		false | -) cmp=0 ;;
		*)
			map_skip=$((map_skip + 1))
			continue
			;;
		esac
		cs="${cs}c $cid $cname $mf $cmp
"
		map_c=$((map_c + 1))
	done
	set +f
	# A name given to two ids in one snapshot (the engine forbids it):
	# both ids are excluded, neither is mapped.
	dupnames=$(printf '%s' "$cs" | awk '{ n[$3]++ } END { for (k in n) if (n[k] > 1) print k }')
	if [ -n "$dupnames" ]; then
		kept=
		while IFS=' ' read -r _ cid cname mf cmp; do
			[ -n "${cid:-}" ] || continue
			if printf '%s\n' "$dupnames" | grep -Fqx -- "$cname"; then
				xs="${xs}x $cid
"
				map_x=$((map_x + 1))
				map_c=$((map_c - 1))
			else
				kept="${kept}c $cid $cname $mf $cmp
"
			fi
		done <<EOF
$cs
EOF
		cs=$kept
	fi
	n=0
	for f in "$map_dir"/map.v*; do
		v=${f##*/map.v}
		case "$v" in '' | 0* | *[!0-9]*) continue ;; esac
		[ ${#v} -le 15 ] || continue
		[ "$v" -le "$n" ] || n=$v
	done
	n=$((n + 1))
	tmp=$(mktemp "$map_dir/.map.tmp.XXXXXX") || return 1
	if ! { printf 'locklog-map 1\n%s%s' "$cs" "$xs" >"$tmp" && chmod 0644 "$tmp" && mv -f "$tmp" "$map_dir/map.v$n"; }; then
		rm -f "$tmp"
		return 1
	fi
	for f in "$map_dir"/map.v*; do
		v=${f##*/map.v}
		case "$v" in '' | 0* | *[!0-9]*) continue ;; esac
		[ ${#v} -le 15 ] || continue
		[ "$v" -ge $((n - 1)) ] || rm -f "$f"
	done
	map_version=$n
}

# map_loop SINCE PID NAME: keep the map current while the console lives:
# its docker run (PID, which replaced the launcher) or, once that pid is
# gone (the CLI killed), its container NAME while it still runs (checked
# every 5 s). Every container create, rename and destroy from SINCE
# (seconds since the epoch) on marks the map dirty, and one rewrite a
# second at most drains the mark (a burst of events costs one rewrite).
# When docker events exits it is restarted, from the time it exited, after
# a backoff doubling up to 30 s, and the map rewritten then. Once the
# console is gone, docker events and the reader are killed and the fifo
# removed. Failures are reported on stderr, once per streak.
map_loop() {
	since=$1
	ppid=$2
	cname=$3
	ev_pid=
	rd_pid=
	cl_checked=
	cl_alive=1
	warned_events=
	warned_map=
	backoff=1
	fifo_dir=$(mktemp -d) || {
		say "warning: mktemp failed: the containers map will not follow container changes (locklog refresh rewrites it)"
		exit 1
	}
	fifo="$fifo_dir/events"
	dirty="$fifo_dir/dirty"
	if ! mkfifo -m 0600 "$fifo"; then
		say "warning: mkfifo failed: the containers map will not follow container changes (locklog refresh rewrites it)"
		rm -rf "$fifo_dir"
		exit 1
	fi
	trap loop_end TERM HUP INT
	while console_alive; do
		# The reader and docker events are started from subshells that
		# exit at once: they are not this shell's children, so kill -0
		# tells when they are gone (no zombie). The reader opens the fifo
		# first, with its output already away from the substitution.
		rd_pid=$({
			while IFS= read -r _; do : >"$dirty"; done
		} >/dev/null <"$fifo" &
			echo $!)
		started=$(date +%s)
		ev_pid=$(docker events --since "$since" --filter type=container --filter event=create \
			--filter event=rename --filter event=destroy --format '{{.Action}}' 2>/dev/null >"$fifo" &
			echo $!)
		while kill -0 "$ev_pid" 2>/dev/null; do
			console_alive || loop_end
			flush_map
			sleep 1
		done
		# Gone: their pids may be reused from here on. The reader ends on
		# the fifo's end of file.
		ev_pid=
		rd_pid=
		console_alive || loop_end
		now=$(date +%s)
		since=$now
		if [ $((now - started)) -ge 30 ]; then
			# It ran a while: a new streak.
			backoff=1
			warned_events=
		fi
		if [ -z "$warned_events" ]; then
			say "warning: docker events stopped; restarting it (backoff up to 30 s) and rewriting the containers map"
			warned_events=1
		fi
		sleep "$backoff"
		backoff=$((backoff * 2))
		[ "$backoff" -le 30 ] || backoff=30
		rm -f "$dirty"
		checked_write
	done
	loop_end
}

# console_alive: the console's docker run lives, or else its container
# still runs (asked at most every 5 s).
console_alive() {
	kill -0 "$ppid" 2>/dev/null && return 0
	now=$(date +%s)
	if [ -n "$cl_checked" ] && [ $((now - cl_checked)) -lt 5 ]; then
		return "$cl_alive"
	fi
	cl_checked=$now
	cl_alive=1
	[ "$(docker inspect -f '{{.State.Running}}' "$cname" 2>/dev/null)" = true ] && cl_alive=0
	return "$cl_alive"
}

# flush_map: rewrite the map once when events marked it dirty.
flush_map() {
	[ -e "$dirty" ] || return 0
	rm -f "$dirty"
	checked_write
}

# checked_write: write_map, warning once per streak of failures.
checked_write() {
	if write_map; then
		warned_map=
	elif [ -z "$warned_map" ]; then
		say "warning: could not rewrite the containers map (docker ps, docker inspect); retrying on the next change"
		warned_map=1
	fi
}

loop_end() {
	[ -z "$ev_pid$rd_pid" ] || kill $ev_pid $rd_pid 2>/dev/null || :
	[ -z "$lock_held" ] || rmdir "$map_dir/.lock" 2>/dev/null || :
	rm -rf "$fifo_dir"
	exit 0
}

# ensure_volume NAME DIR OWNER: the named volume NAME exists, created from
# the image (Docker gives an empty volume the owner and mode of DIR in the
# image on first use), and DIR in it has OWNER (uid:gid:mode). A volume
# someone else created with another owner is refused.
ensure_volume() {
	docker volume inspect "$1" >/dev/null 2>&1 || docker volume create "$1" >/dev/null
	got=$(docker run --rm --network none --user 0 $confined --entrypoint stat -v "$1:$2" "$image" -c '%u:%g:%a' "$2") ||
		die "could not check the owner of the $1 volume"
	[ "$got" = "$3" ] ||
		die "the $1 volume has owner and mode $got, not $3: it was not created by locklog; remove it (docker volume rm $1) and start again"
}

# check_tag TAG: TAG is a release tag (it goes into URLs and into the
# launcher's text).
check_tag() {
	printf '%s\n' "$1" | grep -Eqx 'v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?' ||
		die "invalid version $1: a release tag, vX.Y.Z"
}

# verified_digest TAG: the digest of the release image registry:TAG, once
# cosign verifies its signature by the release workflow; empty when it does
# not verify.
verified_digest() {
	cosign verify --certificate-identity "$identity" \
		--certificate-oidc-issuer https://token.actions.githubusercontent.com \
		"$registry:$1" 2>/dev/null |
		sed -n 's/.*"docker-manifest-digest":"\(sha256:[0-9a-f]\{64\}\)".*/\1/p' | sed -n 1p
}

# update [vX.Y.Z]: replace this launcher with a release's (the cosign
# signature of checksums.txt and the archive's checksum checked, as
# scripts/install.sh does), then pull that release's image.
update() {
	if [ -n "${1:-}" ]; then
		case "$1" in v*) check_tag "$1" ;; *) check_tag "v$1" ;; esac
	fi
	if command -v curl >/dev/null 2>&1; then
		fetch() { curl -fsSL --proto '=https' -o "$2" "$1"; }
		latest() { curl -fsSLI --proto '=https' -o /dev/null -w '%{url_effective}' "https://github.com/$repo/releases/latest"; }
	elif command -v wget >/dev/null 2>&1; then
		if wget --help 2>&1 | grep -q -- --https-only; then
			fetch() { wget -q --https-only -O "$2" "$1"; }
		else
			fetch() { wget -q -O "$2" "$1"; }
		fi
		latest() { wget -q -S --spider "https://github.com/$repo/releases/latest" 2>&1 | sed -n 's/^ *[Ll]ocation: *//p' | tail -n 1 | tr -d '\r'; }
	else
		die "curl or wget is required"
	fi
	case "$(uname -s)" in
	Linux) os=linux ;;
	Darwin) os=darwin ;;
	*) die "unsupported OS $(uname -s): Linux and macOS only" ;;
	esac
	case "$(uname -m)" in
	x86_64 | amd64) arch=amd64 ;;
	aarch64 | arm64) arch=arm64 ;;
	*) die "unsupported architecture $(uname -m): amd64 and arm64 only" ;;
	esac

	tag="${1:-${LOCKLOG_VERSION:-}}"
	if [ -z "$tag" ]; then
		tag="$(latest)" || tag=""
		tag="${tag##*/}"
		case "$tag" in
		v[0-9]*) ;;
		*) die "no published release found; name one: locklog update vX.Y.Z" ;;
		esac
	fi
	case "$tag" in v*) ;; *) tag="v$tag" ;; esac
	check_tag "$tag"
	version="${tag#v}"
	identity="https://github.com/$repo/.github/workflows/release.yml@refs/tags/$tag"
	if [ "$version" = "$launcher_version" ]; then
		say "the launcher is already $tag"
	else
		self="$(command -v "$0" 2>/dev/null || printf '%s' "$0")"
		archive="locklog_${version}_${os}_${arch}.tar.gz"
		base="https://github.com/$repo/releases/download/$tag"
		tmp="$(mktemp -d)"
		trap 'rm -rf "$tmp"' EXIT INT TERM
		say "downloading $archive ($tag)"
		fetch "$base/$archive" "$tmp/$archive" || die "download failed: $base/$archive"
		fetch "$base/checksums.txt" "$tmp/checksums.txt" || die "download failed: checksums.txt"
		command -v cosign >/dev/null 2>&1 ||
			die "cosign is required to check the release's signature (https://docs.sigstore.dev/cosign/system_config/installation/)"
		fetch "$base/checksums.txt.sigstore.json" "$tmp/checksums.txt.sigstore.json" ||
			die "download failed: checksums.txt.sigstore.json"
		cosign verify-blob --bundle "$tmp/checksums.txt.sigstore.json" \
			--certificate-identity "$identity" \
			--certificate-oidc-issuer https://token.actions.githubusercontent.com \
			"$tmp/checksums.txt" >/dev/null 2>&1 || die "cosign: signature of checksums.txt does not verify"
		say "cosign: checksums.txt signature verified"
		want="$(awk -v f="$archive" '$2 == f { print $1 }' "$tmp/checksums.txt")"
		[ -n "$want" ] || die "$archive is not listed in checksums.txt"
		if command -v sha256sum >/dev/null 2>&1; then
			got="$(sha256sum "$tmp/$archive" | awk '{ print $1 }')"
		else
			got="$(shasum -a 256 "$tmp/$archive" | awk '{ print $1 }')"
		fi
		[ "$want" = "$got" ] || die "checksum mismatch for $archive"
		tar -xzf "$tmp/$archive" -C "$tmp" scripts/locklog 2>/dev/null ||
			die "$archive holds no launcher (scripts/locklog)"
		digest="$(verified_digest "$version")"
		vdigest="$(verified_digest "$version-vault")"
		[ -n "$digest" ] && [ -n "$vdigest" ] && [ "$digest" != "$vdigest" ] ||
			die "cosign: the signature of $registry:$version (and -vault) does not verify, or the image is not published yet"
		say "cosign: image $registry:$version verified ($digest)"
		sed -e "s/^launcher_version=dev\$/launcher_version=$version/" \
			-e "s/^image_digest=\$/image_digest=$digest/" \
			-e "s/^vault_image_digest=\$/vault_image_digest=$vdigest/" \
			"$tmp/scripts/locklog" >"$tmp/launcher"
		grep -qx "launcher_version=$version" "$tmp/launcher" || die "the launcher of $tag does not take its version"
		if [ -w "$self" ]; then
			install -m 0755 "$tmp/launcher" "$self"
		else
			command -v sudo >/dev/null 2>&1 || die "$self is not writable and sudo is missing"
			say "replacing $self with sudo"
			sudo install -o root -m 0755 "$tmp/launcher" "$self"
		fi
		say "launcher updated to $tag ($self)"
		image="$registry@$digest"
		[ "${LOCKLOG_VAULT:-0}" = 1 ] && image="$registry@$vdigest"
		[ -n "${LOCKLOG_IMAGE:-}" ] && say "LOCKLOG_IMAGE is set ($LOCKLOG_IMAGE): it still overrides $image"
		rm -rf "$tmp"
		trap - EXIT INT TERM
	fi
	need_docker
	say "pulling $image"
	exec docker pull "$image"
}

# The project is mounted read-only at its own path in every container.
project_mount() {
	[ "$project" != / ] || die "run locklog from a project directory, not from /"
	safe "$project" || die "$project holds a character a docker mount cannot carry: move or rename it"
	safe "$workdir" || die "$workdir holds a character a docker mount cannot carry: move or rename it"
}

# The confinement every locklog container runs with.
confined="--cap-drop ALL --security-opt no-new-privileges --read-only --tmpfs /tmp:rw,nosuid,nodev,noexec,size=64m"

# docker_version KIND VERSION: sets major and minor of a Docker version
# (KIND names it in messages), refusing one before 19.03.
docker_version() {
	major=${2%%.*}
	rest=${2#*.}
	minor=${rest%%.*}
	case "$major$minor" in *[!0-9]* | '') die "unknown Docker $1 version $2" ;; esac
	if [ "$major" -lt 19 ] || { [ "$major" -eq 19 ] && [ "$minor" -lt 3 ]; }; then
		die "Docker $1 $2 is too old: locklog needs Docker 19.03 or later"
	fi
}

# check_project: the trusted project and its .locklog/ (ll_dir), checked
# again right before reading them.
check_project() {
	need_docker
	project_mount
	[ -n "$project_trusted" ] ||
		die "no trusted .locklog/ directory here or above (yours, not a link, writable by no one else): run locklog setup first"
	# Again right before reading it: what the walk accepted.
	shared "$project" && die "$project is writable by someone else than you"
	trusted_config "$project" || die "$project/.locklog changed: it is no longer trusted"
	ll_dir="$project/.locklog"
	physical "$ll_dir" || die "$ll_dir is not a directory with no symbolic link on its path"
	name="locklog-console-$(printf '%s' "$project" | cksum | awk '{ print $1 }')"
}

# read_plan ARGS: the profile's mount plan, derived in the image from
# .locklog/ (as the agent account, no network) and checked here, on the
# host: its header and its lines.
read_plan() {
	planned=$(docker run --rm --network none --user agent --log-driver none $confined --pids-limit 64 --memory 256m \
		-v "$ll_dir:$ll_dir:ro" -w "$project" "$image" mounts "$@") ||
		die "could not read the mount plan of the profile (locklog mounts)"
	header=$(printf '%s\n' "$planned" | sed -n 1p)
	printf '%s\n' "$header" | grep -Eqx 'profile [A-Za-z0-9][A-Za-z0-9_.-]{0,63} (true|false)' ||
		die "mount plan: malformed header"
	lines=$(printf '%s\n' "$planned" | sed -n '2,$p')
}

console() {
	check_project

	# Docker >= 19.03, rootful: rootless engines keep logs the console
	# cannot reach. The non-recursive bind option is parsed by the CLI, so
	# the CLI's version chooses it: CLI 29 refuses bind-nonrecursive, a CLI
	# before 25 does not know bind-recursive. Both set the same API field
	# (Engine >= 19.03).
	sv=$(docker version --format '{{.Server.Version}}' 2>/dev/null) || die "the Docker engine does not answer"
	docker_version engine "$sv"
	cv=$(docker version --format '{{.Client.Version}}' 2>/dev/null) || die "the Docker CLI does not report its version"
	docker_version CLI "$cv"
	if [ "$major" -ge 25 ]; then
		nonrecursive=bind-recursive=disabled
	else
		nonrecursive=bind-nonrecursive=true
	fi
	case "$(docker info --format '{{.SecurityOptions}}' 2>/dev/null)" in
	*rootless*) die "rootless Docker is not supported: its containers' logs and the host's journal are out of the console's reach" ;;
	esac

	read_plan "$@"
	if [ "$(uname -s)" = Darwin ] && [ "$(printf '%s\n' "$lines" | grep -c .)" -gt 0 ]; then
		die "local log sources are not supported with Docker Desktop on macOS (the containers' logs live in its VM); use a remote source"
	fi
	# Read in this shell (no pipe), so that plan_line fills the plan.
	while IFS= read -r l; do
		[ -z "$l" ] || plan_line "$l"
	done <<EOF
$lines
EOF
	docker_args=
	if [ -n "$docker_globs" ]; then
		[ -z "$local_lines" ] ||
			die "a docker source cannot share a console with file or journald sources: the containers root is read with group 0, which would apply to every bound log directory; put the container logs in a profile of their own and run a separate console for them"
		docker_root_bind
		ensure_map_dir "$name"
		# The time before the snapshot: the events loop replays from it, so
		# that nothing between the snapshot and its subscription is lost.
		t0=$(date +%s)
		lock_traps
		write_map || die "could not write the containers map (docker ps, docker inspect)"
		mount_args="$mount_args --mount type=bind,src=$map_dir,dst=/run/locklog-map,readonly"
		docker_args="-e LOCKLOG_DOCKER_ROOT=$docker_root"
		plan_text="$plan_text  containers map $map_dir at /run/locklog-map (read-only): $map_c mapped, $map_x console containers excluded, $map_skip skipped; kept current while the console runs
"
	fi

	net=none
	if [ -n "${LOCKLOG_NETWORK:-}" ]; then
		printf '%s\n' "$LOCKLOG_NETWORK" | grep -Eqx '[A-Za-z0-9][A-Za-z0-9_.-]{0,127}' ||
			die "LOCKLOG_NETWORK: invalid network name $LOCKLOG_NETWORK"
		case "$LOCKLOG_NETWORK" in host | none | bridge) die "LOCKLOG_NETWORK: name a network of your own, not $LOCKLOG_NETWORK" ;; esac
		net=$LOCKLOG_NETWORK
	fi
	n=$(getconf _NPROCESSORS_ONLN 2>/dev/null || nproc 2>/dev/null || echo 1)
	case "$n" in '' | *[!0-9]*) n=1 ;; esac
	cpus=2
	[ "$n" -lt 2 ] && cpus=$n

	ensure_volume locklog-run /run/locklog 10051:10050:2750
	ensure_volume locklog-home /home/locklog 10051:10051:700

	if [ "$(docker inspect -f '{{.State.Running}}' "$name" 2>/dev/null)" = false ]; then
		docker rm "$name" >/dev/null
	fi
	group_args=
	for g in $gids; do group_args="$group_args --group-add $g"; done

	{
		printf 'locklog: console %s, %s\n' "$name" "$header"
		printf '  network %s, cpus %s, memory 1g, pids 256, no log driver\n' "$net" "$cpus"
		printf '%s' "$plan_text"
		[ -z "$gids" ] || printf '  groups%s\n' "$gids"
	} >&2

	set -f
	# shellcheck disable=SC2086 # the plan's arguments are split on purpose
	set -- run --rm "$tty" --name "$name" --label locklog.console=1 --user locklog --log-driver none $confined \
		--pids-limit 256 --memory 1g --cpus "$cpus" --network "$net" \
		-e VAULT_ADDR -e VAULT_NAMESPACE \
		-e "LOCKLOG_NETWORK=${LOCKLOG_NETWORK:-}" -e "LOCKLOG_EXTRA_ROOTS=${LOCKLOG_EXTRA_ROOTS:-}" \
		-e "LOCKLOG_EXPECT_DIR=$(devino "$ll_dir")" -e "LOCKLOG_EXPECT_ROOTS=$expect" $docker_args \
		-v locklog-run:/run/locklog -v locklog-home:/home/locklog -v "$ll_dir:$ll_dir:ro" \
		$group_args $mount_args -w "$project" "$image" console "$@"
	set +f
	[ -n "$docker_globs" ] || exec docker "$@"

	# With a docker source, the map loop runs beside the console, watching
	# this pid: docker run replaces the launcher as on the plain path, so
	# signals, the terminal and the exit status are the console's, and the
	# loop ends with it (also when this process is killed).
	map_loop "$t0" "$$" "$name" &
	exec docker "$@"
}

# refresh ARGS: rewrite the containers map of this project's console once,
# from the approved globs of the profile's docker sources.
refresh() {
	check_project
	read_plan "$@"
	while IFS= read -r l; do
		case "$l" in
		docker\ *) add_docker_glob "${l#docker }" ;;
		esac
	done <<EOF
$lines
EOF
	[ -n "$docker_globs" ] || die "the profile has no docker source: there is no containers map to write"
	ensure_map_dir "$name"
	lock_traps
	write_map || die "could not write the containers map (docker ps, docker inspect)"
	printf 'locklog: containers map v%s of %s (%s): %s mapped, %s console containers excluded, %s skipped (not json-file, or not a valid name)\n' \
		"$map_version" "$name" "$map_dir" "$map_c" "$map_x" "$map_skip"
}

# write_facts FILE [logs]: the facts of this host and account that setup
# and doctor read in the image (internal/hostfacts): ids, group names,
# states, paths and container names, never a log line or a secret. With
# "logs", the files under the log roots follow, one per line, last.
write_facts() {
	{
		echo 'locklog-facts 1'
		echo "euid $(id -u)"
		echo "groups $(id -Gn 2>/dev/null || :)"
		if ! command -v sudo >/dev/null 2>&1; then
			echo 'sudo absent'
		elif sudo -n true >/dev/null 2>&1; then
			echo 'sudo nopasswd'
		else
			echo 'sudo password'
		fi
		if [ -n "${DOCKER_HOST:-}" ]; then echo 'docker_host set'; fi
		dk=
		if docker version --format '{{.Server.Version}}' >/dev/null 2>&1; then
			dk=1
			echo 'docker reachable'
		else
			echo 'docker unreachable'
		fi
		for p in /var/log/journal /var/lib/docker; do
			[ -e "$p" ] || continue
			if ls "$p" >/dev/null 2>&1; then echo "readable $p"; else echo "unreadable $p"; fi
		done
		if [ -n "${HOME:-}" ]; then
			for c in .aws/credentials .config/gcloud/application_default_credentials.json .azure/msal_token_cache.json .azure/accessTokens.json; do
				if [ -f "$HOME/$c" ]; then echo "credfile ~/$c"; fi
			done
		fi
		for j in /var/log/journal /run/log/journal; do
			if [ -d "$j" ] && [ ! -L "$j" ]; then echo "journal $j"; fi
		done
		# The agents, as lockkit's agentwire detects them.
		if command -v claude >/dev/null 2>&1; then echo 'agent claude'; fi
		if command -v codex >/dev/null 2>&1 || [ -d "${CODEX_HOME:-${HOME:-/nonexistent}/.codex}" ]; then echo 'agent codex'; fi
		if command -v cursor >/dev/null 2>&1 || command -v cursor-agent >/dev/null 2>&1 || [ -d "${HOME:-/nonexistent}/.cursor" ]; then echo 'agent cursor'; fi
		if command -v gemini >/dev/null 2>&1 || [ -d "${HOME:-/nonexistent}/.gemini" ]; then echo 'agent gemini'; fi
		if [ -n "$dk" ]; then
			docker ps --format '{{.Names}} {{.Image}} {{with .Label "com.docker.compose.service"}}{{.}}{{else}}-{{end}} {{with .Label "com.docker.compose.project"}}{{.}}{{else}}-{{end}} {{with .Networks}}{{.}}{{else}}-{{end}}' 2>/dev/null |
				sed 's/^/container /' || :
			for cid in $(docker ps -q 2>/dev/null || :); do
				rec=$(docker inspect --type container --format '{{.HostConfig.IpcMode}} {{.Name}}' "$cid" 2>/dev/null) || continue
				case "$rec" in "shareable /"*) echo "ipc_shareable ${rec#shareable /}" ;; esac
			done
			sw=$(docker info --format '{{.Swarm.LocalNodeState}}' 2>/dev/null) || sw=
			case "$sw" in '' | *[!a-z-]*) ;; *) echo "swarm $sw" ;; esac
		fi
		if [ "${2:-}" = logs ]; then
			echo logs
			set -f
			# shellcheck disable=SC2086 # the roots are split on purpose
			find $roots -maxdepth 3 -type f 2>/dev/null || :
			set +f
		fi
	} >"$1"
	chmod 0644 "$1"
}

# setup ARGS: `locklog setup` in the image, as you (your uid and gid, so
# that .locklog/ and the agent files are yours), with this project
# writable, the host's facts, and the directory of the proxies' files
# (outside the project, 0700); no network. The trusted .locklog/ is checked
# here afterwards, as console will check it.
setup() {
	need_docker
	project_mount
	shared "$project" && die "$project is writable by someone else than you, or not yours: run setup in a project directory of your own"
	cfg_home=${XDG_CONFIG_HOME:-}
	case "$cfg_home" in /*) ;; *) [ -n "${HOME:-}" ] || die "HOME is not set"; cfg_home=$HOME/.config ;; esac
	proxy_dir=$cfg_home/locklog/proxy
	(umask 077 && mkdir -p "$proxy_dir") || die "could not create $proxy_dir"
	proxy_dir=$(cd "$proxy_dir" && pwd -P) || die "could not enter $proxy_dir"
	safe "$proxy_dir" || die "$proxy_dir holds a character a docker mount cannot carry"
	trusted "$proxy_dir" || die "$proxy_dir is a link, has an ACL, or is owned or writable by someone else than you"
	facts=$(mktemp) || die "mktemp failed"
	trap 'rm -f "$facts"' EXIT
	trap 'exit 130' INT
	trap 'exit 143' TERM
	write_facts "$facts" logs
	rc=0
	docker run --rm "$tty" --user "$(id -u):$(id -g)" --log-driver none --network none $confined \
		--pids-limit 64 --memory 256m -e "LOCKLOG_IMAGE_REF=$image" \
		-v "$project:$project" -v "$proxy_dir:$proxy_dir" -v "$facts:/run/locklog-facts:ro" -w "$project" \
		"$image" setup --facts /run/locklog-facts --proxy-dir "$proxy_dir" "$@" || rc=$?
	[ "$rc" -eq 0 ] || exit "$rc"
	trusted_config "$project" ||
		die "$project/.locklog or its config.toml is a link, has an ACL, or is writable by someone else than you: fix it before locklog console"
	if [ -f "$project/.claude/settings.local.json" ] && command -v git >/dev/null 2>&1 &&
		git -C "$project" rev-parse --is-inside-work-tree >/dev/null 2>&1 &&
		! git -C "$project" check-ignore -q .claude/settings.local.json; then
		say "warning: git does not ignore .claude/settings.local.json (personal settings, with the allow list): add it to .gitignore"
	fi
}

# doctor ARGS: `locklog doctor` in the image as the agent account, with the
# host's facts, the project read-only, and the host's network (its probes
# see what an agent here reaches). Advisory: it never prints a response
# body.
doctor() {
	need_docker
	project_mount
	facts=$(mktemp) || die "mktemp failed"
	trap 'rm -f "$facts"' EXIT
	trap 'exit 130' INT
	trap 'exit 143' TERM
	write_facts "$facts"
	rc=0
	docker run --rm -i --user agent --log-driver none --network host $confined --pids-limit 64 --memory 256m \
		-v "$project:$project:ro" -v "$facts:/run/locklog-facts:ro" -w "$workdir" \
		"$image" doctor --facts /run/locklog-facts "$@" || rc=$?
	exit "$rc"
}

cmd="${1:-}"
case "$cmd" in
update)
	shift
	update "$@"
	;;
version | --version)
	printf 'locklog launcher %s (image %s)\n' "$launcher_version" "$image"
	need_docker
	exec docker run --rm --network none --user agent $confined "$image" version
	;;
console)
	shift
	console "$@"
	;;
refresh)
	shift
	refresh "$@"
	;;
setup)
	shift
	setup "$@"
	;;
doctor)
	shift
	doctor "$@"
	;;
mcp)
	# The agent speaks MCP on stdin and stdout: no terminal. The server
	# refuses a production profile when LOCKLOG_HOST_AGENT is set: a host
	# agent is the non-production trial.
	need_docker
	project_mount
	exec docker run --rm -i --user agent --log-driver none --network none $confined \
		--pids-limit 64 --memory 256m -e LOCKLOG_HOST_AGENT=1 \
		-v locklog-run:/run/locklog -v "$project:$project:ro" -w "$workdir" "$image" "$@"
	;;
*)
	need_docker
	project_mount
	exec docker run --rm "$tty" --user agent --log-driver none --network none $confined \
		-v locklog-run:/run/locklog -v "$project:$project:ro" -w "$workdir" "$image" "$@"
	;;
esac
